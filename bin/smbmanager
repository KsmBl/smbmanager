#!/usr/bin/env python3
"""Launcher for SMB Manager."""

import os
import sys

# Run straight from a checkout when the package is not installed system wide.
_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if os.path.isdir(os.path.join(_root, "smbmanager")):
    sys.path.insert(0, _root)

from smbmanager.app import main  # noqa: E402

raise SystemExit(main())
